# --- Telegram (get these from https://my.telegram.org -> API Development Tools) ---
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=+2348012345678

# Session string gets generated the first time you run `npm run login`
# and printed to the console — paste it here so you don't have to log in again.
TG_SESSION=

# --- Target channel ---
# Can be a public @username or the numeric channel/chat id (get id via the login script log output)
TG_CHANNEL=@your_target_channel

# --- Selected profiles to watch (comma-separated) ---
# Use numeric Telegram user IDs where possible — usernames can be changed by the trader.
# The login/listener script logs sender id + username for every message it sees in the
# channel for the first few minutes so you can copy the right IDs in.
TG_WATCHED_USER_IDS=111111111,222222222
TG_WATCHED_USERNAMES=trader_alpha,trader_beta

# --- WhatsApp destination ---
# Your own number (or a group), in international format, no + and no spaces,
# followed by @c.us for a person or @g.us for a group.
WA_TARGET=2348012345678@c.us

# --- Backup delivery channel (optional but recommended) ---
# A separate Telegram bot that DMs you directly. Used automatically if a
# WhatsApp send fails, and for heartbeat pings. See backup.js for setup steps.
# Leave both blank to disable — the bot still runs, it just has no fallback.
TG_BOT_TOKEN=
TG_BOT_CHAT_ID=

# --- Heartbeat ---
# How often (in hours) to send a "still alive" ping so silence itself becomes
# a signal that something broke.
HEARTBEAT_HOURS=24

# --- Webhook (optional) ---
# Exposes POST /inject (manually add a call) and POST /correct (override a
# tracked call's status) for manual corrections or external integrations.
# Leave WEBHOOK_PORT blank to disable it entirely (recommended unless you
# need it — it's an open port on your VPS otherwise).
WEBHOOK_PORT=
WEBHOOK_SECRET=
